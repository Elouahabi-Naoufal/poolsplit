generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  publicId               String   @unique
  username               String   @unique
  passwordHash           String
  displayName            String
  avatar                 String?
  avatarData             Bytes?
  avatarMime             String?
  isAdmin                Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  groupMembers           GroupMember[]
  invitationsSent        GroupInvitation[] @relation("Inviter")
  activitiesCreated      Activity[]        @relation("ActivityCreator")
  activityParticipants   ActivityParticipant[]
  activityInvitationsSent ActivityInvitation[] @relation("ActivityInviter")
  activityInvitationsRcvd ActivityInvitation[] @relation("ActivityInvitee")
  settlementTransfersFrom SettlementTransfer[] @relation("TransferFrom")
  settlementTransfersTo   SettlementTransfer[] @relation("TransferTo")
  auditEvents            ActivityEvent[]   @relation("Actor")
  outingsCreated         Outing[]              @relation("OutingCreator")
  outingParticipants     OutingParticipant[]
  outingInvitesSent      OutingInvitation[] @relation("OutingInviter")
  outingInvitesRcvd      OutingInvitation[] @relation("OutingInvitee")
  usageRecords           UsageRecord[]
  usageParticipants      UsageParticipant[]
  usageConfirmations     UsageConfirmation[]
  activityPayments       ActivityPayment[]
  lineItems              LineItem[]            @relation("UserLineItems")
  activityTemplates      ActivityTemplate[]
  correctionRequests     CorrectionRequest[]        @relation("CorrectionRequester")
  correctionDecisions    CorrectionRequest[]      @relation("CorrectionDecider")

  @@index([publicId])
}

// ──────────────────────────────────────────────────
// GROUPS — persistent membership container
// ──────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("PLANNING")
  ownerId     String
  publicToken String?  @unique
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  invitations GroupInvitation[]
  outings     Outing[]
  events      ActivityEvent[]

  @@index([ownerId])
  @@index([status])
}

model GroupMember {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  role         String   @default("MEMBER")
  joinedAt     DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupInvitation {
  id                    String   @id @default(cuid())
  groupId               String
  inviterId             String
  inviteePublicId       String?
  inviteeUserId         String?
  status                String   @default("PENDING")
  createdAt             DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([status])
}

// ──────────────────────────────────────────────────
// OUTINGS — independent financial context
// ──────────────────────────────────────────────────

model Outing {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  description String?
  status      String   @default("PLANNING")
  createdBy   String
  publicToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group         Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User               @relation("OutingCreator", fields: [createdBy], references: [id])
  participants  OutingParticipant[]
  invitations   OutingInvitation[]
  activities    Activity[]
  settlement    Settlement?
  corrections   CorrectionRequest[]

  @@index([groupId])
  @@index([status])
}

model OutingParticipant {
  id       String  @id @default(cuid())
  outingId String
  userId   String
  role     String  @default("MEMBER")
  joinedAt DateTime @default(now())

  outing Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outingId, userId])
  @@index([outingId])
  @@index([userId])
}

model OutingInvitation {
  id              String   @id @default(cuid())
  outingId        String
  inviterId       String
  inviteeUserId   String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  outing   Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)
  inviter  User   @relation("OutingInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee  User   @relation("OutingInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([outingId, inviteeUserId])
  @@index([outingId])
  @@index([status])
}

// ──────────────────────────────────────────────────
// ACTIVITIES — fixed or variable pricing
// ──────────────────────────────────────────────────

model Activity {
  id            String   @id @default(cuid())
  groupId       String?
  outingId      String?
  name          String
  pricingModel  String   @default("FIXED")
  status        String   @default("OPEN")
  startTime     DateTime @default(now())
  endTime       DateTime?
  rate          Int?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outing         Outing?              @relation(fields: [outingId], references: [id], onDelete: SetNull)
  creator        User                 @relation("ActivityCreator", fields: [createdBy], references: [id])
  products       ActivityProduct[]
  usageRecords   UsageRecord[]
  lineItems      LineItem[]
  payments       ActivityPayment[]
  members        ActivityParticipant[]
  invitations    ActivityInvitation[]

  @@index([groupId])
  @@index([outingId])
  @@index([createdBy])
  @@index([status])
}

model ActivityParticipant {
  id         String @id @default(cuid())
  activityId String
  userId     String
  role       String @default("MEMBER")
  joinedAt   DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model ActivityInvitation {
  id              String   @id @default(cuid())
  activityId      String
  inviterId       String
  inviteeUserId   String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inviter  User     @relation("ActivityInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee  User     @relation("ActivityInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([activityId, inviteeUserId])
  @@index([activityId])
  @@index([status])
}

model ActivityProduct {
  id                String   @id @default(cuid())
  activityId        String
  name              String
  unit              String   @default("unit")
  pricePerUnitCt    Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  @@index([activityId])
}

// ──────────────────────────────────────────────────
// FIXED PRICING — usage records + confirmations
// ──────────────────────────────────────────────────

model UsageRecord {
  id             String   @id @default(cuid())
  activityId     String
  productId      String
  quantity       Int
  totalCentimes  Int
  createdById    String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activity      Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  product       ActivityProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation(fields: [createdById], references: [id])
  participants  UsageParticipant[]
  confirmations UsageConfirmation[]

  @@index([activityId])
  @@index([productId])
  @@index([status])
}

model UsageParticipant {
  id            String @id @default(cuid())
  usageRecordId String
  userId        String

  usageRecord UsageRecord @relation(fields: [usageRecordId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([usageRecordId, userId])
  @@index([usageRecordId])
  @@index([userId])
}

model UsageConfirmation {
  id            String   @id @default(cuid())
  usageRecordId String
  userId        String
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usageRecord UsageRecord @relation(fields: [usageRecordId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([usageRecordId, userId])
  @@index([usageRecordId])
  @@index([status])
}

// ──────────────────────────────────────────────────
// VARIABLE PRICING — line items
// ──────────────────────────────────────────────────

model LineItem {
  id           String   @id @default(cuid())
  activityId   String
  userId       String
  description  String
  priceCentimes Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation("UserLineItems", fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([userId])
}

// ──────────────────────────────────────────────────
// ACTIVITY TEMPLATES — reusable activity definitions
// ──────────────────────────────────────────────────

model ActivityTemplate {
  id           String   @id @default(cuid())
  userId       String
  name         String
  pricingModel String   @default("FIXED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ActivityTemplateProduct[]

  @@index([userId])
}

model ActivityTemplateProduct {
  id             String   @id @default(cuid())
  templateId     String
  name           String
  unit           String   @default("unit")
  pricePerUnitCt Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ──────────────────────────────────────────────────
// ACTIVITY PAYMENTS — who paid what
// ──────────────────────────────────────────────────

model ActivityPayment {
  id             String   @id @default(cuid())
  activityId     String
  userId         String
  amountCentimes Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([userId])
}

// ──────────────────────────────────────────────────
// CORRECTIONS — post-settlement change requests
// ──────────────────────────────────────────────────

model CorrectionRequest {
  id            String   @id @default(cuid())
  outingId      String
  requesterId   String
  deciderId     String?
  entityType    String
  entityId      String
  field         String
  oldValue      String
  newValue      String
  status        String   @default("PENDING")
  decisionNote  String?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?

  outing   Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)
  requester User  @relation("CorrectionRequester", fields: [requesterId], references: [id])
  decider   User? @relation("CorrectionDecider", fields: [deciderId], references: [id])

  @@index([outingId])
  @@index([status])
}

// ──────────────────────────────────────────────────
// SETTLEMENT — tied to outing, not group
// ──────────────────────────────────────────────────

model Settlement {
  id                 String   @id @default(cuid())
  outingId           String?  @unique
  groupId            String?
  totalExpenses      Int
  totalPaid          Int
  totalContributions Int      @default(0)
  publicToken        String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  outing     Outing?              @relation(fields: [outingId], references: [id], onDelete: SetNull)
  transfers  SettlementTransfer[]

  @@index([groupId])
}

model SettlementTransfer {
  id             String   @id @default(cuid())
  settlementId   String
  fromUserId     String
  toUserId       String
  amountCentimes Int
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  paidAt         DateTime?
  confirmedAt    DateTime?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  fromUser   User       @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser     User       @relation("TransferTo", fields: [toUserId], references: [id])

  @@index([settlementId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  groupId    String
  outingId   String?
  actorId    String?
  eventType  String
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor  User?  @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([actorId])
  @@index([eventType])
  @@index([outingId])
}
